(allow duchamp_daemon_release_probe self (capability
    (dac_override sys_admin sys_nice sys_ptrace)))
(allow duchamp_daemon_release_probe self (unix_stream_socket
    (create ioctl read getattr write setattr lock append bind connect listen
     accept getopt setopt shutdown map)))
(allow duchamp_daemon_release_probe self (netlink_kobject_uevent_socket
    (create bind read getattr getopt setopt)))

(allow duchamp_daemon_release_probe duchamp_daemon_data_release_probe
    (dir (add_name create getattr ioctl lock open read remove_name search
          setattr write)))
(allow duchamp_daemon_release_probe duchamp_daemon_data_release_probe
    (file (append create getattr ioctl lock map open read rename setattr unlink
           write)))

(allow duchamp_app_release_probe duchamp_daemon_release_probe
    (unix_stream_socket (connectto)))

(allow duchamp_daemon_release_probe sysfs (dir (search)))
(allow duchamp_daemon_release_probe duchamp_mali_devfreq_release_probe (dir (getattr search open read)))
(allow duchamp_daemon_release_probe duchamp_mali_devfreq_release_probe (file (getattr open read write ioctl lock map)))
(allow duchamp_daemon_release_probe duchamp_battery_supply_release_probe (file (getattr open read write ioctl lock map)))

(allow duchamp_daemon_release_probe duchamp_sysfs_rw_release_probe
    (dir (getattr open read search)))
(allow duchamp_daemon_release_probe duchamp_sysfs_rw_release_probe
    (file (getattr ioctl lock map open read write)))
(allow duchamp_daemon_release_probe duchamp_proc_rw_release_probe
    (file (getattr ioctl lock map open read write)))
(allow duchamp_daemon_release_probe duchamp_swap_block_release_probe
    (blk_file (getattr ioctl lock map open read write)))
(allow duchamp_daemon_release_probe duchamp_input_device_release_probe
    (chr_file (getattr ioctl lock map open read write)))

(allow duchamp_daemon_release_probe duchamp_touch_hal_release_probe
    (binder (call transfer)))
(allow duchamp_touch_hal_release_probe duchamp_daemon_release_probe
    (binder (transfer)))
(allow duchamp_daemon_release_probe duchamp_touch_hal_release_probe (fd (use)))
(allow duchamp_daemon_release_probe duchamp_touch_hal_release_probe (process (ptrace)))
(allow duchamp_daemon_release_probe duchamp_touch_hal_release_probe (dir (search)))
(allow duchamp_daemon_release_probe duchamp_touch_hal_release_probe (file (getattr open read write)))

(allow duchamp_daemon_release_probe duchamp_display_hal_release_probe
    (binder (call transfer)))
(allow duchamp_display_hal_release_probe duchamp_daemon_release_probe
    (binder (transfer)))
(allow duchamp_daemon_release_probe duchamp_display_hal_release_probe (fd (use)))
(allow duchamp_daemon_release_probe duchamp_hal_service_release_probe
    (service_manager (find)))

(allow duchamp_daemon_release_probe system_server (binder (call transfer)))
(allow system_server duchamp_daemon_release_probe (binder (transfer)))
(allow duchamp_daemon_release_probe system_server (fd (use)))
(allow system_server duchamp_daemon_release_probe (fd (use)))
(allow system_server duchamp_daemon_release_probe (fifo_file (write)))
(allow duchamp_daemon_release_probe display_service (service_manager (find)))
(allow duchamp_daemon_release_probe power_service (service_manager (find)))
(allow duchamp_daemon_release_probe settings_service (service_manager (find)))
(allow duchamp_daemon_release_probe window_service (service_manager (find)))
(allow duchamp_daemon_release_probe activity_service (service_manager (find)))
(allow duchamp_daemon_release_probe package_service (service_manager (find)))
(allow duchamp_daemon_release_probe logd (unix_stream_socket (connectto)))
(allow duchamp_daemon_release_probe logdr_socket (sock_file (write)))
(allow duchamp_daemon_release_probe overlay_service (service_manager (find)))
(allow duchamp_daemon_release_probe system_file
    (file (execute execute_no_trans getattr map open read)))
(allow duchamp_daemon_release_probe toolbox_exec
    (file (execute execute_no_trans getattr map open read)))
