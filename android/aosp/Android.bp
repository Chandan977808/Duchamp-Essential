// Duchamp Essential prebuilt integration for the product partition.

package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

android_app_import {
    name: "DuchampEssential",
    apk: "prebuilt/DuchampEssential.apk",
    presigned: true,
    preprocessed: true,
    product_specific: true,
    required: ["duchamp_daemon"],
    dex_preopt: {
        enabled: false,
    },
}

cc_prebuilt_binary {
    name: "duchamp_daemon",
    srcs: ["prebuilt/duchamp_daemon"],
    compile_multilib: "64",
    product_specific: true,
    shared_libs: [
        "libbinder_ndk",
        "libc",
        "libdl",
    ],
    strip: {
        none: true,
    },
    init_rc: ["duchamp_daemon.rc"],
}

cc_prebuilt_binary {
    name: "duchamp_ctl",
    srcs: ["prebuilt/duchamp_ctl"],
    compile_multilib: "64",
    product_specific: true,
    shared_libs: [
        "libc",
        "libdl",
    ],
    strip: {
        none: true,
    },
}
