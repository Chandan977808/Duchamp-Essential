; Duchamp Essential offline image integration. Merge into a loaded policy file.
; This fragment requires the Xiaomi Duchamp vendor labels; compile the full ROM.
(type duchamp_daemon)
(type duchamp_daemon_exec)
(type duchamp_daemon_data_file)
(type duchamp_app)
(type duchamp_app_userfaultfd)
(typeattribute duchamp_app_userfaultfd_others)
(typeattribute duchamp_app_ptrace_forbidden)
(type sysfs_duchamp_mali_devfreq)
(type sysfs_duchamp_touch)
(type sysfs_duchamp_subsystem)
(type sysfs_duchamp_subsystem_floor)
(roletype object_r duchamp_daemon)
(roletype object_r duchamp_daemon_exec)
(roletype object_r duchamp_daemon_data_file)
(roletype object_r duchamp_app)
(roletype object_r duchamp_app_userfaultfd)
(roletype object_r sysfs_duchamp_mali_devfreq)
(roletype object_r sysfs_duchamp_touch)
(roletype object_r sysfs_duchamp_subsystem)
(roletype object_r sysfs_duchamp_subsystem_floor)
(typeattributeset domain (duchamp_daemon duchamp_app))
(typeattributeset coredomain (duchamp_daemon duchamp_app))
(typeattributeset mlstrustedsubject (duchamp_daemon))
(typeattributeset appdomain (duchamp_app))
(typeattributeset untrusted_app_all (duchamp_app))
(typeattributeset netdomain (duchamp_app))
(typeattributeset exec_type (duchamp_daemon_exec))
(typeattributeset file_type (duchamp_daemon_exec duchamp_daemon_data_file))
(typeattributeset system_file_type (duchamp_daemon_exec))
(typeattributeset data_file_type (duchamp_daemon_data_file))
(typeattributeset core_data_file_type (duchamp_daemon_data_file))
(typeattributeset fs_type (sysfs_duchamp_mali_devfreq sysfs_duchamp_touch))
(typeattributeset sysfs_type (sysfs_duchamp_mali_devfreq sysfs_duchamp_touch))
(typeattributeset fs_type (sysfs_duchamp_subsystem sysfs_duchamp_subsystem_floor))
(typeattributeset sysfs_type (sysfs_duchamp_subsystem sysfs_duchamp_subsystem_floor))

; Equivalent app_domain essentials; Android's existing app rules still apply.
(typetransition duchamp_app tmpfs file appdomain_tmpfs)
(allow duchamp_app appdomain_tmpfs (file (execute getattr map read write ioctl)))
(allowx duchamp_app appdomain_tmpfs (ioctl file ((range 0x7701 0x770b))))
(typetransition duchamp_app duchamp_app anon_inode "[userfaultfd]" duchamp_app_userfaultfd)
(allow duchamp_app duchamp_app_userfaultfd (anon_inode (create ioctl read)))
(typeattributeset duchamp_app_userfaultfd_others (and (domain) (not (duchamp_app))))
(typeattributeset duchamp_app_ptrace_forbidden (and (domain) (not (duchamp_app crash_dump runas_app simpleperf))))
(neverallow duchamp_app_userfaultfd_others duchamp_app_userfaultfd (anon_inode (create ioctl read)))
(neverallow duchamp_app_ptrace_forbidden duchamp_app (process (ptrace)))

; Init startup, owned state and the certificate-bound app control socket.
(typetransition init duchamp_daemon_exec process duchamp_daemon)
(allow init duchamp_daemon (process (transition rlimitinh siginh)))
(allow init duchamp_daemon_exec (file (getattr open read execute map)))
(allow duchamp_daemon duchamp_daemon_exec (file (entrypoint getattr open read execute map)))
(allow duchamp_app duchamp_daemon (unix_stream_socket (connectto)))
(allow duchamp_daemon self (unix_stream_socket (ioctl read write create getattr setattr lock append bind connect listen accept getopt setopt shutdown)))
(allow duchamp_daemon self (capability (dac_override sys_admin sys_nice sys_ptrace)))
(allow duchamp_daemon self (netlink_kobject_uevent_socket (create bind read getattr getopt setopt)))
(allow duchamp_daemon duchamp_daemon_data_file (dir (ioctl read write create getattr setattr lock rename add_name remove_name reparent search open rmdir)))
(allow duchamp_daemon duchamp_daemon_data_file (file (ioctl read write create getattr setattr lock append map unlink link rename open)))

; Framework commands, including output pipe/FD replies.
(allow duchamp_daemon servicemanager (binder (call transfer)))
(allow servicemanager duchamp_daemon (binder (call transfer)))
(allow servicemanager duchamp_daemon (dir (search)))
(allow servicemanager duchamp_daemon (file (read open)))
(allow servicemanager duchamp_daemon (process (getattr)))
(allow duchamp_daemon system_server (binder (call transfer)))
(allow system_server duchamp_daemon (binder (transfer)))
(allow duchamp_daemon system_server (fd (use)))
(allow system_server duchamp_daemon (fd (use)))
(allow system_server duchamp_daemon (fifo_file (write)))
(allow duchamp_daemon display_service (service_manager (find)))
(allow duchamp_daemon power_service (service_manager (find)))
(allow duchamp_daemon settings_service (service_manager (find)))
(allow duchamp_daemon window_service (service_manager (find)))
(allow duchamp_daemon activity_service (service_manager (find)))
(allow duchamp_daemon package_service (service_manager (find)))
; Passive foreground event stream for Per-App Controls.
(allow duchamp_daemon logd (unix_stream_socket (connectto)))
(allow duchamp_daemon logdr_socket (sock_file (read write open getattr)))
(allow duchamp_daemon overlay_service (service_manager (find)))
(allow duchamp_daemon system_file (file (getattr open read execute map execute_no_trans)))
(allow duchamp_daemon toolbox_exec (file (getattr open read execute map execute_no_trans)))

; Hardware nodes. No generic sysfs file write permission.
(allow duchamp_daemon sysfs (dir (search)))
; Battery class links need parent traversal before leaf permissions apply.
; No sysfs_batteryinfo file access is granted.
(allow duchamp_daemon sysfs_batteryinfo (dir (search)))
(allow duchamp_daemon sysfs_devices_system_cpu (dir (search getattr open read)))
(allow duchamp_daemon sysfs_devices_system_cpu (file (read write getattr open ioctl lock map)))
(allow duchamp_daemon sysfs_devices_block (dir (search getattr open read)))
(allow duchamp_daemon sysfs_devices_block (file (read write getattr open ioctl lock map)))
(allow duchamp_daemon sysfs_memory (dir (search getattr open read)))
(allow duchamp_daemon sysfs_memory (file (read write getattr open ioctl lock map)))
(allow duchamp_daemon sysfs_ged (dir (search getattr open read)))
(allow duchamp_daemon sysfs_ged (file (read write getattr open ioctl lock map)))
(allow duchamp_daemon sysfs_mali_power_policy (dir (search getattr open read)))
(allow duchamp_daemon sysfs_mali_power_policy (file (read write getattr open ioctl lock map)))
(allow duchamp_daemon sysfs_therm (dir (search getattr open read)))
(allow duchamp_daemon sysfs_therm (file (read write getattr open ioctl lock map)))
(allow duchamp_daemon sysfs_usb_supply (dir (search getattr open read)))
(allow duchamp_daemon sysfs_usb_supply (file (read write getattr open ioctl lock map)))
(allow duchamp_daemon sysfs_battery_supply (dir (search getattr open read)))
(allow duchamp_daemon sysfs_battery_supply (file (read write getattr open ioctl lock map)))
(allow duchamp_daemon sysfs_zram (dir (search getattr open read)))
(allow duchamp_daemon sysfs_zram (file (read write getattr open ioctl lock map)))
(allow duchamp_daemon sysfs_fs_f2fs (dir (search getattr open read)))
(allow duchamp_daemon sysfs_fs_f2fs (file (read write getattr open ioctl lock map)))
(allow duchamp_daemon sysfs_blockio (dir (search getattr open read)))
(allow duchamp_daemon sysfs_blockio (file (read write getattr open ioctl lock map)))
; Screen-state detection has a framework power-service fallback. Do not grant
; coredomain access to generic LED files, forbidden by the stock platform.
(allow duchamp_daemon vendor_sysfs_displayfeature (dir (search getattr open read)))
(allow duchamp_daemon vendor_sysfs_displayfeature (file (read getattr open ioctl lock map)))
(allow duchamp_daemon proc_powerhal_cpu_ctrl (file (read write getattr open ioctl lock map)))
(allow duchamp_daemon proc_touch_boost (file (read write getattr open ioctl lock map)))
(allow duchamp_daemon proc_tp_file (file (read getattr open ioctl lock map)))
(allow duchamp_daemon proc_swappiness (file (read write getattr open ioctl lock map)))
(allow duchamp_daemon proc_drop_caches (file (write open getattr)))
(allow duchamp_daemon input_device (chr_file (read write getattr open ioctl lock map)))
(allow duchamp_daemon swap_block_device (blk_file (read write getattr open ioctl lock map)))
(allow duchamp_daemon sysfs_duchamp_mali_devfreq (dir (search getattr open read)))
(allow duchamp_daemon sysfs_duchamp_mali_devfreq (file (read write getattr open ioctl lock map)))
(allow duchamp_daemon sysfs_duchamp_touch (dir (search getattr open read)))
(allow duchamp_daemon sysfs_duchamp_touch (file (read write getattr open ioctl lock map)))
(genfscon sysfs "/devices/platform/soc/13000000.mali/devfreq/13000000.mali" (u object_r sysfs_duchamp_mali_devfreq ((s0) (s0))))
(genfscon sysfs "/devices/platform/13000000.mali/devfreq/13000000.mali" (u object_r sysfs_duchamp_mali_devfreq ((s0) (s0))))
(genfscon sysfs "/devices/platform/goodix_ts.0" (u object_r sysfs_duchamp_touch ((s0) (s0))))

; Subsystem metadata is read-only; requests are confined to min_freq/max_freq.
(allow duchamp_daemon sysfs_duchamp_subsystem (dir (search getattr open read)))
(allow duchamp_daemon sysfs_duchamp_subsystem (file (read getattr open)))
(allow duchamp_daemon sysfs_duchamp_subsystem_floor (file (read write getattr open)))
; Preserve the target ROM's RAM parent label and existing controller access.
(allow duchamp_daemon sysfs_dvfsrc_devfreq (dir (search getattr open read)))
(allow duchamp_daemon sysfs_dvfsrc_devfreq (file (read getattr open)))
(allow mtk_hal_power sysfs_duchamp_subsystem (dir (ioctl read getattr lock open watch watch_reads search)))
(allow mtk_hal_power sysfs_duchamp_subsystem (file (ioctl read write getattr lock append map open watch watch_reads)))
(allow mtk_hal_power sysfs_duchamp_subsystem_floor (file (ioctl read write getattr lock append map open watch watch_reads)))
(genfscon sysfs "/devices/platform/soc/1c00f000.dvfsrc/mtk-dvfsrc-devfreq/devfreq/mtk-dvfsrc-devfreq/min_freq" (u object_r sysfs_duchamp_subsystem_floor ((s0) (s0))))
(genfscon sysfs "/devices/platform/soc/1c00f000.dvfsrc/mtk-dvfsrc-devfreq/devfreq/mtk-dvfsrc-devfreq/max_freq" (u object_r sysfs_duchamp_subsystem_floor ((s0) (s0))))
(genfscon sysfs "/devices/platform/soc/112b0000.ufshci/devfreq/112b0000.ufshci" (u object_r sysfs_duchamp_subsystem ((s0) (s0))))
(genfscon sysfs "/devices/platform/soc/112b0000.ufshci/devfreq/112b0000.ufshci/min_freq" (u object_r sysfs_duchamp_subsystem_floor ((s0) (s0))))
(genfscon sysfs "/devices/platform/soc/112b0000.ufshci/devfreq/112b0000.ufshci/max_freq" (u object_r sysfs_duchamp_subsystem_floor ((s0) (s0))))

; Xiaomi vendor services and narrowly scoped native THP timing access.
(allow duchamp_daemon vendor_hal_displayfeature_xiaomi_service (service_manager (find)))
(allow duchamp_daemon vendor_hal_displayfeature_xiaomi_default (binder (call transfer)))
(allow vendor_hal_displayfeature_xiaomi_default duchamp_daemon (binder (transfer)))
(allow duchamp_daemon vendor_hal_displayfeature_xiaomi_default (fd (use)))
(allow duchamp_daemon hal_touchfeature_xiaomi_service (service_manager (find)))
(allow duchamp_daemon hal_touchfeature_xiaomi_default (binder (call transfer)))
(allow hal_touchfeature_xiaomi_default duchamp_daemon (binder (transfer)))
(allow duchamp_daemon hal_touchfeature_xiaomi_default (fd (use)))
(allow duchamp_daemon hal_touchfeature_xiaomi_default (process (ptrace)))
(allow duchamp_daemon hal_touchfeature_xiaomi_default (dir (search)))
(allow duchamp_daemon hal_touchfeature_xiaomi_default (file (getattr open read write)))
